{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app12",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e69d482d-65d4-470e-9bd5-d9509480e941","database_name": "web-app12" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3d25609554584532b1e9343949f3eeab" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
